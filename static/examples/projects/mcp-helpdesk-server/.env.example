# Copy to .env and adjust. Never commit a real .env.
# ---- runtime
HELPDESK_ENVIRONMENT=dev            # dev | test | prod (prod refuses dev secrets)
HELPDESK_TRANSPORT=http             # http | stdio
HELPDESK_HOST=127.0.0.1
HELPDESK_PORT=8000
HELPDESK_MCP_PATH=/mcp
HELPDESK_PUBLIC_BASE_URL=           # e.g. https://helpdesk-mcp.example.com
HELPDESK_LOG_LEVEL=INFO
HELPDESK_LOG_JSON=true

# ---- database (SQLite for local, Postgres in compose/prod)
HELPDESK_DATABASE_URL=sqlite+aiosqlite:///./helpdesk.db
# HELPDESK_DATABASE_URL=postgresql+asyncpg://helpdesk:helpdesk@localhost:5432/helpdesk

# ---- authentication
HELPDESK_AUTH_MODE=jwt              # jwt | local (local = no token, stdio/loopback only)
HELPDESK_JWT_ALGORITHM=HS256        # HS256 (dev shared secret) | RS256 (IdP keys)
HELPDESK_JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
HELPDESK_JWT_JWKS_URI=              # RS256: https://login.example.com/.well-known/jwks.json
HELPDESK_JWT_ISSUER=https://idp.example.internal
HELPDESK_JWT_AUDIENCE=helpdesk-mcp
HELPDESK_LOCAL_USER=local-admin
HELPDESK_LOCAL_TENANT=acme
HELPDESK_LOCAL_ROLES=["admin"]

# ---- robustness
HELPDESK_TOOL_TIMEOUT_S=20
HELPDESK_RATE_LIMIT_PER_MINUTE=120
HELPDESK_RATE_LIMIT_BURST=30
HELPDESK_MAX_PAGE_SIZE=100
HELPDESK_CONFIRM_TOKEN_TTL_S=300
HELPDESK_CURSOR_SECRET=dev-only-cursor-secret-change-me

# ---- LLM for triage suggestions ("fake" = offline deterministic model)
HELPDESK_LLM_PROVIDER=fake          # fake | openai | anthropic | ... (LangChain init_chat_model)
HELPDESK_LLM_MODEL=gpt-4o-mini
HELPDESK_LLM_TIMEOUT_S=15
HELPDESK_LLM_MAX_RETRIES=2
# OPENAI_API_KEY=sk-...

# ---- optional LangSmith tracing of triage LLM calls
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=helpdesk-mcp
