                "type": "integer"
              },
              "priority": {
                "enum": [
                  "p1",
                  "p2",
                  "p3",
                  "p4"
                ],
                "type": "string"
              },
              "requester": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "open",
                  "in_progress",
                  "waiting_on_user",
                  "resolved",
                  "closed"
