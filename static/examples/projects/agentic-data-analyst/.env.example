# Copy to .env. Everything is optional: with no changes the app runs fully offline.

# --- model -----------------------------------------------------------------
# offline = deterministic scripted model + hashing embeddings (no keys, no network)
# real    = LangChain chat model + embeddings from the provider below
ANALYST_LLM_MODE=offline
ANALYST_LLM_PROVIDER=openai
ANALYST_LLM_MODEL=gpt-4o-mini
ANALYST_EMBEDDING_PROVIDER=openai
ANALYST_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=sk-...

# --- tracing (LangSmith) ----------------------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=data-analyst

# --- safety and limits ------------------------------------------------------
ANALYST_MAX_RETRIES=3
ANALYST_DEFAULT_LIMIT=200
ANALYST_MAX_LIMIT=1000
ANALYST_ROW_CAP=1000
ANALYST_QUERY_TIMEOUT_S=10
ANALYST_APPROVAL_ROW_THRESHOLD=100000
ANALYST_APPROVAL_WORK_THRESHOLD=5000000

# --- service ------------------------------------------------------------------
# ANALYST_API_KEY=change-me
ANALYST_LOG_LEVEL=INFO
ANALYST_LOG_JSON=false
