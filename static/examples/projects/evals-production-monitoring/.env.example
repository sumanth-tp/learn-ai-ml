# Copy to .env. Everything works offline with the defaults below.
# fake = deterministic offline models; openai = real OpenAI (or any OpenAI-compatible URL)
AGENTMON_LLM_PROVIDER=fake
AGENTMON_MODEL_NAME=gpt-4o-mini
AGENTMON_JUDGE_MODEL_NAME=gpt-4o-mini
# AGENTMON_LLM_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=sk-...

AGENTMON_DB_PATH=var/agentmon.db
AGENTMON_OUT_DIR=out
AGENTMON_PROMPT_VERSION=v1
AGENTMON_GUARDRAILS_ENABLED=true
AGENTMON_LOG_LEVEL=INFO

# Optional OpenTelemetry export (install the otlp extra)
# AGENTMON_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Optional LangSmith tracing (read by LangChain directly)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=agentmon
